# =============================================================================
# .env — 本番環境設定
# 場所: /var/www/vanzai/.env（VPS上）
# 注意: このファイルをGitにコミットしないこと！
# =============================================================================

# ----------------------------------------
# データベース（PostgreSQL）
# ----------------------------------------
# /root/db_credentials.txt の値を貼り付ける
DATABASE_URL=postgresql://vanzai_db:<DB_PASSWORD>@localhost:5432/vanzai_prod

# ----------------------------------------
# JWT認証
# ----------------------------------------
# 生成コマンド: openssl rand -hex 32
JWT_SECRET_KEY=<openssl rand -hex 32 で生成した値>
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ----------------------------------------
# メール設定
# ----------------------------------------
EMAIL_DRY_RUN=false
EMAIL_PROVIDER=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=<Gmailアドレス>
SMTP_PASSWORD=<Gmailアプリパスワード>
SMTP_FROM_EMAIL=<Gmailアドレス>
SMTP_FROM_NAME=VANZAI System

# ----------------------------------------
# 本番環境フラグ
# ----------------------------------------
ENV=production
