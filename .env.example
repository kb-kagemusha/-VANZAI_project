# 環境変数設定例（.env）
#
# 注意:
# - 実トークン/秘密鍵はコミットしない
# - Kintoneは「アプリ別APIトークン」を推奨（KINTONE_TOKEN_*）

# ===========================
# データベース設定
# ===========================
DATABASE_URL=sqlite:///./vanzai.db
# PostgreSQL使用時:
# DATABASE_URL=postgresql://user:password@localhost:5432/vanzai

# ===========================
# JWT認証設定
# ===========================
# 必須: 本番環境では必ず十分な長さのランダム文字列を設定すること。
# 未設定のまま起動すると RuntimeError で即座停止する。
# 例: openssl rand -hex 32
JWT_SECRET_KEY=<必ず32文字以上のランダム文字列に置き換える>
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ===========================
# メール送信設定
# ===========================
# DRY_RUN: true=送信せずログ出力のみ、false=実送信
EMAIL_DRY_RUN=true
# プロバイダー: gmail/sendgrid/ses
EMAIL_PROVIDER=gmail

# SMTP設定（Gmail例）
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=VANZAI System

# SendGrid設定（使用する場合）
# EMAIL_PROVIDER=sendgrid
# SENDGRID_API_KEY=your-sendgrid-api-key

# AWS SES設定（使用する場合）
# EMAIL_PROVIDER=ses
# AWS_REGION=us-east-1
# AWS_SMTP_USERNAME=your-aws-smtp-username
# AWS_SMTP_PASSWORD=your-aws-smtp-password

# ===========================
# Kintone設定
# ===========================
KINTONE_SUBDOMAIN=your-subdomain
# ゲストスペースで運用する場合のみ設定（空なら通常スペース）
KINTONE_GUEST_SPACE_ID=

# 互換用（単一トークン運用時のみ）
# KINTONE_API_TOKEN=your-api-token

# アプリ別APIトークン（推奨）
KINTONE_TOKEN_WORKERS=your-workers-token
KINTONE_TOKEN_CLIENTS=your-clients-token
KINTONE_TOKEN_SITES=your-sites-token
KINTONE_TOKEN_ROLES=your-roles-token
KINTONE_TOKEN_PROJECT_TYPES=your-project-types-token
KINTONE_TOKEN_PROJECTS=your-projects-token
KINTONE_TOKEN_SHIFT_SLOTS=your-shift-slots-token
KINTONE_TOKEN_ASSIGNMENTS=your-assignments-token
KINTONE_TOKEN_ACTUALS=your-actuals-token
KINTONE_TOKEN_PRICE_SALES=your-price-sales-token
KINTONE_TOKEN_PRICE_OUTSOURCE=your-price-outsource-token
KINTONE_TOKEN_PRICE_RULES=your-price-rules-token
KINTONE_TOKEN_EXPENSES=your-expenses-token
KINTONE_TOKEN_INCENTIVES=your-incentives-token
KINTONE_TOKEN_INCENTIVE_RULES=your-incentive-rules-token
KINTONE_TOKEN_INVOICES=your-invoices-token
KINTONE_TOKEN_PAYOUTS=your-payouts-token
KINTONE_TOKEN_PAYOUT_DELIVERIES=your-payout-deliveries-token
KINTONE_TOKEN_BANK_TRANSFERS=your-bank-transfers-token
KINTONE_TOKEN_BANK_TRANSFER_BATCHES=your-bank-transfer-batches-token
KINTONE_TOKEN_EQUIPMENT=your-equipment-token
KINTONE_TOKEN_EQUIPMENT_LOANS=your-equipment-loans-token
KINTONE_TOKEN_SYSTEM_SETTINGS=your-system-settings-token
KINTONE_TOKEN_TASKS=your-tasks-token
KINTONE_TOKEN_PROJECT_DOCUMENTS=your-project-documents-token
KINTONE_TOKEN_SUPPLIERS=your-suppliers-token
KINTONE_TOKEN_VANZAI_STAFF=your-vanzai-staff-token

# アプリID（Kintoneで作成済みのアプリIDを設定）
KINTONE_APP_WORKERS=0
KINTONE_APP_CLIENTS=0
KINTONE_APP_SITES=0
KINTONE_APP_ROLES=0
KINTONE_APP_PROJECT_TYPES=0
KINTONE_APP_PROJECTS=0
KINTONE_APP_SHIFT_SLOTS=0
KINTONE_APP_ASSIGNMENTS=0
KINTONE_APP_ACTUALS=0
KINTONE_APP_PRICE_SALES=0
KINTONE_APP_PRICE_OUTSOURCE=0
KINTONE_APP_PRICE_RULES=0
KINTONE_APP_EXPENSES=0
KINTONE_APP_INCENTIVES=0
KINTONE_APP_INCENTIVE_RULES=0
KINTONE_APP_INVOICES=0
KINTONE_APP_PAYOUTS=0
KINTONE_APP_PAYOUT_DELIVERIES=0
KINTONE_APP_BANK_TRANSFERS=0
KINTONE_APP_BANK_TRANSFER_BATCHES=0
KINTONE_APP_EQUIPMENT=0
KINTONE_APP_EQUIPMENT_LOANS=0
KINTONE_APP_TASKS=0
KINTONE_APP_PROJECT_DOCUMENTS=0
KINTONE_APP_SYSTEM_SETTINGS=0
KINTONE_APP_SUPPLIERS=0
KINTONE_APP_VANZAI_STAFF=0

# ===========================
# スケジューラー設定
# ===========================
SCHEDULER_ENABLED=true
# 週次催促メール送信曜日（0=月曜日、6=日曜日）
SCHEDULER_WEEKLY_DAY=0
# 週次催促メール送信時刻（時）
SCHEDULER_WEEKLY_HOUR=9
# 日次ダッシュボード更新時刻（時）
SCHEDULER_DAILY_HOUR=6
# 月次請求書生成日（1-28）
SCHEDULER_MONTHLY_DAY=1
# 月次請求書生成時刻（時）
SCHEDULER_MONTHLY_HOUR=10

# ===========================
# API設定
# ===========================
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
API_CORS_ORIGINS=http://localhost:3000,http://localhost:8501

# ===========================
# OCR設定
# ===========================
OCR_STORAGE_ROOT=storage/ocr
# OCR_ENGINE_DISABLED=false

# ===========================
# ログ設定
# ===========================
LOG_LEVEL=INFO
# DEBUG, INFO, WARNING, ERROR, CRITICAL
